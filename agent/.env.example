# Agent 服务环境配置示例
# 使用方法：复制为 .env 并按需填写

# ============================================
# LangChain Embeddings（向量化模型）
# 本地 Embedding：EMBEDDING_PROVIDER=local 时生效
# 在线 Embedding：EMBEDDING_PROVIDER=openai 时生效
# ============================================
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# DashScope 统一 Key（也用于 Embedding 在线模式）
DASHSCOPE_API_KEY=your-api-key

# ============================================
# 重排模型
# ============================================
RERANKER_MODEL_PATH=
RERANKER_TOP_N=3

# ============================================
# LLM（OpenAI 兼容接口）
# ============================================
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ============================================
# LangChain VectorStore（Chroma）
# ============================================
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=test_agent
CHROMA_DISTANCE_METRIC=cosine

# ============================================
# LangChain Retriever（文档切分与向量召回）
# ============================================
RETRIEVER_CHUNK_SIZE=2000
RETRIEVER_CHUNK_OVERLAP=50
RETRIEVER_SEARCH_K=5
RETRIEVER_SCORE_THRESHOLD=0.5

# ============================================
# 被调用者：测试平台后端接口
# ============================================
BACKEND_BASE_URL=http://localhost:8080
BACKEND_AUTH_TYPE=bearer
BACKEND_API_KEY=
BACKEND_TOKEN=
BACKEND_TIMEOUT=30
BACKEND_MAX_RETRIES=3
BACKEND_VERIFY_SSL=true

# ============================================
# LangChain / LangGraph Agent
# ============================================
AGENT_SYSTEM_PROMPT=
AGENT_MAX_ITERATIONS=10
AGENT_TOOL_CHOICE=auto
AGENT_ALLOWED_TOOLS=
AGENT_BLOCKED_TOOLS=
AGENT_ENABLE_HUMAN_IN_THE_LOOP=false

# ============================================
# LangChain Tools 定义来源
# ============================================
TOOL_CONFIG_PATH=
TOOL_OPENAPI_SPEC_PATH=
TOOL_API_SCHEMA_DIR=

# ============================================
# LangChain Memory
# ============================================
MEMORY_MEMORY_TYPE=window
MEMORY_MAX_HISTORY_TURNS=10
MEMORY_SESSION_STORE_PATH=./sessions

# ============================================
# 应用通用
# ============================================
APP_LOG_LEVEL=INFO
APP_DATA_DIR=./data
APP_UPLOAD_DIR=./uploads
APP_REQUEST_TIMEOUT=60
